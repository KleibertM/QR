{
  "name": "qr-comunidad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n tailwind,vite \"npm:tailwind:watch\" \"vite\"",
    "tailwind:build": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css",
    "tailwind:watch": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css --watch",
    "build": "npm run tailwind:build && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
